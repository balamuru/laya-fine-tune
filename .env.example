# ==============================================================================
# Real-Time Stream Analytics - Example Configuration (.env.example)
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Infrastructure (NATS JetStream)
# ------------------------------------------------------------------------------
NATS_URL=nats://nats:4222
JETSTREAM_RAW_SUBJECT=stream.raw
JETSTREAM_ENRICHED_SUBJECT=stream.enriched
JETSTREAM_TTL=60s
JETSTREAM_MAX_MSGS=10000

# ------------------------------------------------------------------------------
# 2. Ingestion Settings (Bluesky Firehose & Sieve)
# ------------------------------------------------------------------------------
JETSTREAM_WS_URL=wss://jetstream1.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post
SIEVE_ROOT_POSTS_ONLY=true
SIEVE_EN_ONLY=true

# ------------------------------------------------------------------------------
# 3. System One Inference Service Configuration
# Compatible with local Laya or hosted TypeSafe Jev
# ------------------------------------------------------------------------------
# Client Inference Settings
SYSTEM_ONE_URL=http://laya-serve:8111
SYSTEM_ONE_BATCH_SIZE=32
SYSTEM_ONE_API_KEY=your_system_one_api_key_here

# Local Laya Server Core Runtime Settings (used if running local Laya container)
LAYA_IMAGE=vinaybalamuru/laya:cuda
HF_TOKEN=your_huggingface_token_here

# Hardware / GPU Optimizations (Laya Local)
LAYA_GPU_ID=0
LAYA_DEVICE=cuda
LAYA_CUDA_AMP=fp16
LAYA_PRELOAD=1
LAYA_MAX_LOADED=1
LAYA_MODELS=english
OMP_NUM_THREADS=4
HF_HUB_OFFLINE=0

# ------------------------------------------------------------------------------
# 4. Analytics Sink Configuration (ClickHouse)
# ------------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_DATABASE=bluesky
SINK_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# 5. Escalation Trigger Settings (Phase 4)
# ------------------------------------------------------------------------------
JETSTREAM_ESCALATION_SUBJECT=stream.escalation
TRIGGER_THRESHOLD_BREAKING=0.95

# ------------------------------------------------------------------------------
# 6. Active Learning & Distillation Settings (Phase 5)
# ------------------------------------------------------------------------------
DISTILLATION_ENABLED=false
DISTILLATION_CONFIDENCE_MIN=0.2
DISTILLATION_CONFIDENCE_MAX=0.6
DISTILLATION_SAMPLE_RATE=0.10
GEMINI_API_KEY=your_gemini_api_key_here
